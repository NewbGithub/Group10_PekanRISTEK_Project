# Backend base URL — see lost-and-found_backend/docs/API_CONTRACT.md
# The backend allows only CORS_ORIGIN values (default http://localhost:5173),
# so either run Vite on 5173 or add your port to the backend .env.
VITE_API_BASE_URL=http://localhost:3000

# Mock data is the default. Set to "false" to use the real backend API.
VITE_USE_MOCK=true
