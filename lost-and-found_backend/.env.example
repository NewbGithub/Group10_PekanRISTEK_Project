# Salin file ini menjadi ".env" lalu isi. JANGAN commit ".env".

PORT=3000
NODE_ENV=development

# Alamat frontend yang diizinkan (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:5173

# Zona waktu untuk validasi "tanggal tidak boleh di masa depan"
APP_TIMEZONE=Asia/Jakarta

# Penyimpanan data: "memory" (Checkpoint 2) atau "prisma" (Checkpoint 3)
STORAGE=memory

# --- Wajib jika STORAGE=prisma ---
# Contoh lokal: postgresql://postgres:PASSWORD@localhost:5432/lostfound?schema=public
DATABASE_URL=

# --- Upload foto (Checkpoint 3). Jika kosong, foto diabaikan ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
